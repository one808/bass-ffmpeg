// Version resource for bass-ffmpeg.dll. @VERSION@ and @VERSIONNUM@ are
// substituted by scripts/build-plugin.sh from the VERSION file at the
// repository root.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSIONNUM@
 PRODUCTVERSION @VERSIONNUM@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "bass-ffmpeg project"
            VALUE "FileDescription", "BASS add-on - FFmpeg-based all-format audio playback (incl. audio from video files)"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "bass-ffmpeg"
            VALUE "LegalCopyright", "GPL v3 or later"
            VALUE "OriginalFilename", "bass-ffmpeg.dll"
            VALUE "ProductName", "bass-ffmpeg"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
